      "user_message": "I'm planning a themed movie night with friends. What's one specific classic movie that everyone should watch? Just give me one movie recommendation, no options.",
      "expected_behavior": "Agent should provide specific information in response to: \"Classic movie recommendation\"",
      "agent_response": "Casablanca",
